{
  "name": "stay-on-track",
  "private": true,
  "description": "Habit tracker: a learning project with every piece of a real app.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
